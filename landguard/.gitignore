# ---------- Data runtime artefacts ----------
# These two files are mutated by /api/parcels/{id}/verify at runtime.
# We track the initial canonical version but ignore local runtime state
# so demos don't accidentally commit a half-verified chain.
# Recreate empty with `python -m backend.reset`.
data/audit_events.json
data/verification_records.json

